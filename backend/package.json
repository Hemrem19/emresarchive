{
  "name": "citavers-backend",
  "version": "1.0.0",
  "description": "Backend API for citavErs - Research Paper Management",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "pnpm run db:migrate:deploy && node src/server.js",
    "start:prod": "node src/server.js",
    "db:migrate": "drizzle-kit generate:sqlite",
    "db:migrate:deploy": "wrangler d1 migrations apply",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:auth": "node test-auth.js",
    "test:auth:compat": "node test-auth-compat.js",
    "test:papers": "node test-papers.js",
    "test:all": "node test-papers.js",
    "test:s3": "node test-s3.js"
  },
  "keywords": [
    "research",
    "papers",
    "api",
    "nodejs",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/s3-presigned-post": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.3",
    "hono": "^4.12.12",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.8",
    "resend": "^3.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@vitest/coverage-v8": "^1.6.0",
    "drizzle-kit": "^0.20.14",
    "patch-package": "^8.0.1",
    "supertest": "^6.1.6",
    "typescript": "^6.0.2",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}