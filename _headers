# Cloudflare Pages response headers.
# Code must revalidate on every load (cheap 304 via ETag) so a deploy reaches
# browsers immediately; otherwise ES modules from different deploys mix and
# fail with "doesn't provide an export named ...".
/*.js
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/service-worker.js
  Cache-Control: no-cache
